		annotation SummarizationSetBy = Automatic

	column 'Posting Date'
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: bddb33a5-09b1-4c47-8a58-849e4b02b67f
		summarizeBy: none
		sourceColumn: Posting Date

		annotation SummarizationSetBy = Automatic

	column 'Due Date'
		dataType: dateTime
		formatString: dd.MM.yyyy
