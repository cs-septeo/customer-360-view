		sourceColumn: Aging Sort

		annotation SummarizationSetBy = Automatic

	partition 'ERP Open Items' = m
		mode: import
		source =
				let
				    Today = Date.From(DateTime.LocalNow()),
				    Source = Sql.Database("v0201-044-sql01.stp.ag\DWH", "DWH"),
				    Data = Source{[Schema = "ERP", Item = "Debitorenposten"]}[Data],
				    Filtered = Table.SelectRows(Data, each [open] = "1"),
				    Selected = Table.SelectColumns(Filtered, {"EntryKey", "DebitorKey", "Entity", "document_no", "document_type", "description", "posting_date", "due_date", "remaining_amount", "remaining_amt_lcy", "currency_code", "last_issued_reminder_level"}),
				    Renamed = Table.RenameColumns(Selected, {{"EntryKey", "Entry Key"}, {"document_no", "Document No"}, {"document_type", "Document Type"}, {"description", "Description"}, {"posting_date", "Posting Date"}, {"due_date", "Due Date"}, {"remaining_amount", "Remaining Amount"}, {"remaining_amt_lcy", "Remaining Amount LCY"}, {"currency_code", "Currency"}, {"last_issued_reminder_level", "Reminder Level"}}),
				    Cleaned = Table.TransformColumns(Renamed, {{"Currency", each if _ = null or _ = "" then "LCY" else _, type text}, {"Reminder Level", each if _ = null then 0 else _, Int64.Type}}),
				    DaysOverdue = Table.AddColumn(Cleaned, "Days Overdue", each if [Due Date] <> null and [Due Date] < Today then Duration.Days(Today - [Due Date]) else 0, Int64.Type),
				    AgingSort = Table.AddColumn(DaysOverdue, "Aging Sort", each if [Days Overdue] = 0 then 0 else if [Days Overdue] <= 30 then 1 else if [Days Overdue] <= 60 then 2 else if [Days Overdue] <= 90 then 3 else 4, Int64.Type),
				    AgingBucket = Table.AddColumn(AgingSort, "Aging Bucket", each {"Not due", "1-30 days", "31-60 days", "61-90 days", "> 90 days"}{[Aging Sort]}, type text),
				    Typed = Table.TransformColumnTypes(AgingBucket, {{"Posting Date", type datetime}, {"Due Date", type datetime}, {"Remaining Amount", Currency.Type}, {"Remaining Amount LCY", Currency.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

