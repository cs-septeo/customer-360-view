/// Open customer ledger entries (Offene Posten) from Business Central, DWH ERP.Debitorenposten where open = 1. Includes the last issued reminder level (Mahnstufe) and aging. Days Overdue and Aging Bucket are calculated at refresh time. Related to fact account via DebitorKey -> BC ID.
table 'ERP Open Items'
	lineageTag: cd8b7205-3d60-448d-a67e-8d25f5d24eb7

	/// Remaining amount of all open customer ledger entries (invoices minus unapplied payments/credits).
	measure 'Open Amount' = SUM ( 'ERP Open Items'[Remaining Amount] )
		formatString: #,0.00
		displayFolder: Account Detail
		lineageTag: 17fe33e3-211f-445d-9535-763ff294a029

	/// Positive remaining amount of open ledger entries whose due date has passed.
	measure 'Overdue Amount' = CALCULATE ( SUM ( 'ERP Open Items'[Remaining Amount] ), 'ERP Open Items'[Days Overdue] > 0, 'ERP Open Items'[Remaining Amount] > 0 )
		formatString: #,0.00
		displayFolder: Account Detail
		lineageTag: 6fdfe366-3ea3-496f-bffa-20f961ffb608

	/// Number of overdue open ledger entries with a positive remaining amount.
	measure 'Overdue Items' = CALCULATE ( COUNTROWS ( 'ERP Open Items' ), 'ERP Open Items'[Days Overdue] > 0, 'ERP Open Items'[Remaining Amount] > 0 )
		formatString: #,0
		displayFolder: Account Detail
		lineageTag: ab4f282d-689b-424a-9346-b7c5d3cc1b1b

	/// Highest reminder level (Mahnstufe) issued on any open ledger entry; 0 = no reminder.
	measure 'Max Reminder Level' = COALESCE ( MAX ( 'ERP Open Items'[Reminder Level] ), 0 )
		formatString: 0
		displayFolder: Account Detail
		lineageTag: 283f6ecd-0f48-494f-b990-85dbc3bf804f

	/// Color for conditional formatting: red = reminder issued, yellow = overdue, green = up to date.
	measure 'Payment Status Color' = SWITCH ( TRUE (), [Max Reminder Level] > 0, "#FF543A", [Overdue Amount] > 0, "#F2C94C", "#1DD291" )
		displayFolder: Account Detail\Formatting
		lineageTag: cb839ce9-3efc-4d6b-aa81-fc8945294f53

