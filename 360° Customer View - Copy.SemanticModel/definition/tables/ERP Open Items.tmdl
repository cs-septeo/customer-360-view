		annotation SummarizationSetBy = Automatic

	/// Open amount of the ledger entry in document currency; negative for unapplied payments or credits.
	column 'Remaining Amount'
		dataType: decimal
		formatString: #,0.00
		lineageTag: 67a10bdb-4a78-4bca-a956-298fb0566ee0
		summarizeBy: sum
		sourceColumn: Remaining Amount

	column 'Remaining Amount LCY'
		dataType: decimal
		formatString: #,0.00
		lineageTag: 6da92d02-b219-4952-b445-00f77bb15f18
		summarizeBy: sum
		sourceColumn: Remaining Amount LCY

	column Currency
		dataType: string
		lineageTag: 07ce9310-05cb-4d29-9536-65bea67e5422
