		summarizeBy: sum
		sourceColumn: Remaining Amount

	column Currency
		dataType: string
		lineageTag: bdaaab63-8cf0-40ca-b36c-192b12b99695
		summarizeBy: none
		sourceColumn: Currency

		annotation SummarizationSetBy = Automatic

	column 'Order No'
		dataType: string
		lineageTag: 6572affd-0101-4c1c-8da8-e6e8d17c1038
		summarizeBy: none
		sourceColumn: Order No

