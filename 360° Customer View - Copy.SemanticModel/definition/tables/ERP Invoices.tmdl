/// Posted sales invoices (Rechnungen) from Business Central, DWH ERP.SalesHeaderInvoice. Last 3 years plus any invoice with a remaining amount. Related to fact account via DebitorKey -> BC ID.
table 'ERP Invoices'
	lineageTag: cddc6d30-0b2a-4d48-a48a-5581e52a8e15

	/// Number of posted sales invoices (BC) in the current filter context.
	measure 'Invoice Count' = COUNTROWS ( 'ERP Invoices' )
		formatString: #,0
		displayFolder: Account Detail
		lineageTag: 148608d9-8ebf-44c9-9e7f-1ecdd664ebea

	/// Net amount of posted sales invoices (BC), in document currency.
	measure 'Invoiced Amount' = SUM ( 'ERP Invoices'[Net Amount] )
		formatString: #,0.00
		displayFolder: Account Detail
		lineageTag: 4d25873f-b8ef-477f-aa53-2654a88474b6

	/// Net invoiced amount posted in the last 12 months.
	measure 'Invoiced Amount (12M)' = CALCULATE ( [Invoiced Amount], 'ERP Invoices'[Posting Date] > EDATE ( TODAY (), -12 ) )
		formatString: #,0.00
		displayFolder: Account Detail
		lineageTag: 30071379-9386-441e-ae36-f0556ac11dc7

	/// Invoices with a remaining amount and a due date before today (as of last refresh).
	measure 'Overdue Invoices' = CALCULATE ( COUNTROWS ( 'ERP Invoices' ), 'ERP Invoices'[Is Overdue] = TRUE () )
		formatString: #,0
		displayFolder: Account Detail
		lineageTag: c57d5f34-e7e9-4896-8286-33837de2cbe4

	/// Name of the account in the current filter context (page subtitle of Account Detail).
	measure 'Selected Account Name' = SELECTEDVALUE ( 'fact account'[Account Name], "Multiple accounts selected" )
		displayFolder: Account Detail\Formatting
		lineageTag: f121ad26-8d90-4227-9972-8cd1e5c9cd5c

	column 'Invoice Key'
		dataType: string
		isHidden
		lineageTag: 6c1167d1-ee9d-4df8-99d6-59225e24e04b
		summarizeBy: none
		sourceColumn: Invoice Key

		annotation SummarizationSetBy = Automatic

	column DebitorKey
		dataType: string
		isHidden
		lineageTag: b35ec0d2-5e14-43f9-8d1a-d6af4369f622
		summarizeBy: none
		sourceColumn: DebitorKey

		annotation SummarizationSetBy = Automatic

	column Entity
		dataType: string
		lineageTag: 914806f6-7ea2-4443-a3b2-248e2b64aca6
		summarizeBy: none
		sourceColumn: Entity

		annotation SummarizationSetBy = Automatic

	column 'Invoice No'
