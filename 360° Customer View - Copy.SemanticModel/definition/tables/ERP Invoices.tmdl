/// Posted sales invoices (Rechnungen) from Business Central, DWH ERP.SalesHeaderInvoice. Last 3 years plus any invoice with a remaining amount. Related to fact account via DebitorKey -> BC ID.
table 'ERP Invoices'
	lineageTag: cddc6d30-0b2a-4d48-a48a-5581e52a8e15

	/// Number of posted sales invoices (BC) in the current filter context.
	measure 'Invoice Count' = COUNTROWS ( 'ERP Invoices' )
		formatString: #,0
		displayFolder: Account Detail
		lineageTag: 148608d9-8ebf-44c9-9e7f-1ecdd664ebea

	/// Net amount of posted sales invoices (BC), in document currency.
	measure 'Invoiced Amount' = SUM ( 'ERP Invoices'[Net Amount] )
		displayFolder: Account Detail
		lineageTag: 4d25873f-b8ef-477f-aa53-2654a88474b6

		formatStringDefinition =
				VAR _codes = SELECTCOLUMNS ( VALUES ( 'ERP Invoices'[Currency Code] ), "Code", 'ERP Invoices'[Currency Code] )
				VAR _n = COUNTROWS ( _codes )
				VAR _code = MAXX ( _codes, [Code] )
				RETURN SWITCH ( TRUE (), _n = 0, "#,0.00", _n > 1, "#,0.00 ""(mixed currencies)""", _code = "EUR", """€"" #,0.00", _code = "USD", """$"" #,0.00", """" & _code & """ #,0.00" )

	/// Net invoiced amount posted in the last 12 months (ignores the Period slicer).
	measure 'Invoiced Amount (12M)' = CALCULATE ( [Invoiced Amount], REMOVEFILTERS ( 'Detail Calendar' ), 'ERP Invoices'[Posting Date] > EDATE ( TODAY (), -12 ) )
		displayFolder: Account Detail
		lineageTag: 30071379-9386-441e-ae36-f0556ac11dc7

		formatStringDefinition =
				VAR _codes = SELECTCOLUMNS ( VALUES ( 'ERP Invoices'[Currency Code] ), "Code", 'ERP Invoices'[Currency Code] )
				VAR _n = COUNTROWS ( _codes )
				VAR _code = MAXX ( _codes, [Code] )
				RETURN SWITCH ( TRUE (), _n = 0, "#,0.00", _n > 1, "#,0.00 ""(mixed currencies)""", _code = "EUR", """€"" #,0.00", _code = "USD", """$"" #,0.00", """" & _code & """ #,0.00" )

	/// Invoices with a remaining amount and a due date before today (as of last refresh).
	measure 'Overdue Invoices' = CALCULATE ( COUNTROWS ( 'ERP Invoices' ), 'ERP Invoices'[Is Overdue] = TRUE () )
		formatString: #,0
		displayFolder: Account Detail
		lineageTag: c57d5f34-e7e9-4896-8286-33837de2cbe4

	/// Name of the account in the current filter context (page subtitle of Account Detail).
	measure 'Selected Account Name' = IF ( HASONEVALUE ( 'fact account'[Account Name] ), VALUES ( 'fact account'[Account Name] ), "All accounts (" & FORMAT ( COUNTROWS ( 'fact account' ), "#,0" ) & ")" )
		displayFolder: Account Detail\Formatting
		lineageTag: f121ad26-8d90-4227-9972-8cd1e5c9cd5c

	/// Unpaid (remaining) amount of posted sales invoices, in document currency.
	measure 'Invoice Remaining Amount' = SUM ( 'ERP Invoices'[Remaining Amount] )
		displayFolder: Account Detail
		lineageTag: 62fc9090-0243-4c57-aa7d-2c8cbbeece07

		formatStringDefinition =
				VAR _codes = SELECTCOLUMNS ( VALUES ( 'ERP Invoices'[Currency Code] ), "Code", 'ERP Invoices'[Currency Code] )
				VAR _n = COUNTROWS ( _codes )
				VAR _code = MAXX ( _codes, [Code] )
				RETURN SWITCH ( TRUE (), _n = 0, "#,0.00", _n > 1, "#,0.00 ""(mixed currencies)""", _code = "EUR", """€"" #,0.00", _code = "USD", """$"" #,0.00", """" & _code & """ #,0.00" )

	/// Net invoiced amount posted 13 to 24 months ago (ignores the Period slicer).
	measure 'Invoiced Amount (Prior 12M)' = CALCULATE ( [Invoiced Amount], REMOVEFILTERS ( 'Detail Calendar' ), 'ERP Invoices'[Posting Date] > EDATE ( TODAY (), -24 ), 'ERP Invoices'[Posting Date] <= EDATE ( TODAY (), -12 ) )
		displayFolder: Account Detail
		lineageTag: e80fe167-3de8-4295-a7f1-56e01c31ce02

		formatStringDefinition =
				VAR _codes = SELECTCOLUMNS ( VALUES ( 'ERP Invoices'[Currency Code] ), "Code", 'ERP Invoices'[Currency Code] )
				VAR _n = COUNTROWS ( _codes )
				VAR _code = MAXX ( _codes, [Code] )
				RETURN SWITCH ( TRUE (), _n = 0, "#,0.00", _n > 1, "#,0.00 ""(mixed currencies)""", _code = "EUR", """€"" #,0.00", _code = "USD", """$"" #,0.00", """" & _code & """ #,0.00" )

	/// Change of the net invoiced amount of the last 12 months versus the 12 months before.
	measure 'Invoiced 12M vs Prior %' =
			VAR _cur = [Invoiced Amount (12M)]
			VAR _prev = [Invoiced Amount (Prior 12M)]
			RETURN IF ( NOT ISBLANK ( _prev ) && _prev <> 0, DIVIDE ( _cur - _prev, ABS ( _prev ) ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Account Detail
		lineageTag: 4efdaaf7-d099-4aba-94c5-30b83c7440f1

	/// Gross invoiced amount of the last 12 months; denominator of DSO.
	measure 'Invoiced Gross (12M)' = CALCULATE ( SUM ( 'ERP Invoices'[Gross Amount] ), REMOVEFILTERS ( 'Detail Calendar' ), 'ERP Invoices'[Posting Date] > EDATE ( TODAY (), -12 ) )
		formatString: #,0.00
		isHidden
		displayFolder: Account Detail\Helpers
		lineageTag: 35e054dd-f4c0-4c28-9982-0d5a21333b58

	/// Red when invoicing decreased versus the prior 12 months, green otherwise.
	measure 'Trend Color' = VAR _t = [Invoiced 12M vs Prior %] RETURN IF ( NOT ISBLANK ( _t ), IF ( _t < 0, "#FF543A", "#1DD291" ) )
		displayFolder: Account Detail\Formatting
		lineageTag: 0d93aa07-a32b-4d73-a724-15d141bbb105

	column 'Invoice Key'
		dataType: string
		isHidden
		lineageTag: 6c1167d1-ee9d-4df8-99d6-59225e24e04b
		summarizeBy: none
		sourceColumn: Invoice Key

		annotation SummarizationSetBy = Automatic

	column DebitorKey
		dataType: string
		isHidden
		lineageTag: b35ec0d2-5e14-43f9-8d1a-d6af4369f622
		summarizeBy: none
		sourceColumn: DebitorKey

		annotation SummarizationSetBy = Automatic

	/// Business Central company code (e.g. 1STP, ADHO, STCH).
	column Entity
		dataType: string
		lineageTag: 914806f6-7ea2-4443-a3b2-248e2b64aca6
		summarizeBy: none
		sourceColumn: Entity

		annotation SummarizationSetBy = Automatic

	/// Posted sales invoice number (Rechnungsnr.).
	column 'Invoice No'
		dataType: string
		lineageTag: 2a9fa833-15fb-42dc-9651-acc2fcc77cbb
		summarizeBy: none
		sourceColumn: Invoice No

		annotation SummarizationSetBy = Automatic

	column 'Customer Name'
		dataType: string
		lineageTag: 18d59ae8-a853-4cc1-8886-ffd5a9b73716
		summarizeBy: none
		sourceColumn: Customer Name

		annotation SummarizationSetBy = Automatic

	column 'Posting Date'
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: 97f5300d-f4f1-49a6-a321-5eb82c823438
		summarizeBy: none
		sourceColumn: Posting Date

		annotation SummarizationSetBy = Automatic

	column 'Due Date'
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: 051165cf-827e-4c16-a33d-198a928ad3e3
		summarizeBy: none
		sourceColumn: Due Date

		annotation SummarizationSetBy = Automatic

	column 'Net Amount'
		dataType: decimal
		formatString: #,0.00
		lineageTag: 96ce9989-5cb1-44cb-b116-7aced6f332a1
		summarizeBy: sum
		sourceColumn: Net Amount

	column 'Gross Amount'
		dataType: decimal
		formatString: #,0.00
		lineageTag: d7c535e4-3593-48b3-8417-2a2805c2e366
		summarizeBy: sum
		sourceColumn: Gross Amount

	/// Amount of the invoice still unpaid (gross, document currency).
	column 'Remaining Amount'
		dataType: decimal
		formatString: #,0.00
		lineageTag: 0fdc8e71-0aa6-49af-aed0-8e2c9803d7e9
		summarizeBy: sum
		sourceColumn: Remaining Amount

	/// Document currency; LCY = local currency of the company (EUR, CHF for STCH).
	column Currency
		dataType: string
		lineageTag: bdaaab63-8cf0-40ca-b36c-192b12b99695
		summarizeBy: none
		sourceColumn: Currency

		annotation SummarizationSetBy = Automatic

	column 'Order No'
		dataType: string
		lineageTag: 6572affd-0101-4c1c-8da8-e6e8d17c1038
		summarizeBy: none
		sourceColumn: Order No

		annotation SummarizationSetBy = Automatic

	column 'External Document No'
		dataType: string
		lineageTag: ce62a1fb-b783-4c9b-96f5-a29b18f43d70
		summarizeBy: none
		sourceColumn: External Document No

		annotation SummarizationSetBy = Automatic

	column 'Your Reference'
		dataType: string
		lineageTag: eed1f348-2d6e-4672-ac1f-7a5114bf3c16
		summarizeBy: none
		sourceColumn: Your Reference

		annotation SummarizationSetBy = Automatic

	column Cancelled
		dataType: boolean
		lineageTag: d1eed28c-63d6-4755-8893-afc29aa175ed
		summarizeBy: none
		sourceColumn: Cancelled

		annotation SummarizationSetBy = Automatic

	/// True when the invoice has a remaining amount and the due date is before the last refresh date.
	column 'Is Overdue'
		dataType: boolean
		lineageTag: f8f9b7ab-5dca-487f-9132-a4f84e7659aa
		summarizeBy: none
		sourceColumn: Is Overdue

		annotation SummarizationSetBy = Automatic

	/// First day of the posting month, used as chart axis.
	column 'Posting Month' = DATE ( YEAR ( 'ERP Invoices'[Posting Date] ), MONTH ( 'ERP Invoices'[Posting Date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 515a2deb-f98b-4949-90f8-ff5470153a6f
		summarizeBy: none

	/// ISO currency of the document. LCY is resolved to the company currency: CHF for STCH, EUR for all other companies (CRM company default currency).
	column 'Currency Code' = IF ( 'ERP Invoices'[Currency] = "LCY", IF ( 'ERP Invoices'[Entity] = "STCH", "CHF", "EUR" ), 'ERP Invoices'[Currency] )
		dataType: string
		lineageTag: 17adc78e-7bae-49ac-901a-42500e115039

	partition 'ERP Invoices' = m
		mode: import
		source =
				let
				    Today = Date.From(DateTime.LocalNow()),
				    Source = Sql.Database("v0201-044-sql01.stp.ag\DWH", "DWH"),
				    Data = Source{[Schema = "ERP", Item = "SalesHeaderInvoice"]}[Data],
				    Filtered = Table.SelectRows(Data, each [PostingDate] >= Date.AddYears(Today, -3) or [AmountRemaining] <> 0),
				    Selected = Table.SelectColumns(Filtered, {"SalesInvoiceKey", "DebitorKey", "Entity", "SalesInvoiceNo", "sell_to_customer_name", "PostingDate", "DueDate", "Amount", "AmountGross", "AmountRemaining", "currency_code", "order_no", "external_document_no", "your_reference", "cancelled"}),
				    Renamed = Table.RenameColumns(Selected, {{"SalesInvoiceKey", "Invoice Key"}, {"SalesInvoiceNo", "Invoice No"}, {"sell_to_customer_name", "Customer Name"}, {"PostingDate", "Posting Date"}, {"DueDate", "Due Date"}, {"Amount", "Net Amount"}, {"AmountGross", "Gross Amount"}, {"AmountRemaining", "Remaining Amount"}, {"currency_code", "Currency"}, {"order_no", "Order No"}, {"external_document_no", "External Document No"}, {"your_reference", "Your Reference"}, {"cancelled", "Cancelled"}}),
				    Cleaned = Table.TransformColumns(Renamed, {{"Currency", each if _ = null or _ = "" then "LCY" else _, type text}, {"Cancelled", each _ = 1, type logical}}),
				    Overdue = Table.AddColumn(Cleaned, "Is Overdue", each [Remaining Amount] <> 0 and [Due Date] <> null and [Due Date] < Today, type logical),
				    Typed = Table.TransformColumnTypes(Overdue, {{"Posting Date", type datetime}, {"Due Date", type datetime}, {"Net Amount", Currency.Type}, {"Gross Amount", Currency.Type}, {"Remaining Amount", Currency.Type}})
				in
				    Typed

	annotation PBI_ResultType = Exception

