	column Cancelled
		dataType: boolean
		lineageTag: d1eed28c-63d6-4755-8893-afc29aa175ed
		summarizeBy: none
		sourceColumn: Cancelled

		annotation SummarizationSetBy = Automatic

	column 'Is Overdue'
		dataType: boolean
		lineageTag: f8f9b7ab-5dca-487f-9132-a4f84e7659aa
		summarizeBy: none
		sourceColumn: Is Overdue

		annotation SummarizationSetBy = Automatic

	/// First day of the posting month, used as chart axis.
	column 'Posting Month' = DATE ( YEAR ( 'ERP Invoices'[Posting Date] ), MONTH ( 'ERP Invoices'[Posting Date] ), 1 )
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: 515a2deb-f98b-4949-90f8-ff5470153a6f
		summarizeBy: none

	partition 'ERP Invoices' = m
		mode: import
		source =
				let
				    Today = Date.From(DateTime.LocalNow()),
				    Source = Sql.Database("v0201-044-sql01.stp.ag\DWH", "DWH"),
				    Data = Source{[Schema = "ERP", Item = "SalesHeaderInvoice"]}[Data],
				    Filtered = Table.SelectRows(Data, each [PostingDate] >= Date.AddYears(Today, -3) or [AmountRemaining] <> 0),
				    Selected = Table.SelectColumns(Filtered, {"SalesInvoiceKey", "DebitorKey", "Entity", "SalesInvoiceNo", "sell_to_customer_name", "PostingDate", "DueDate", "Amount", "AmountGross", "AmountRemaining", "currency_code", "order_no", "external_document_no", "your_reference", "cancelled"}),
				    Renamed = Table.RenameColumns(Selected, {{"SalesInvoiceKey", "Invoice Key"}, {"SalesInvoiceNo", "Invoice No"}, {"sell_to_customer_name", "Customer Name"}, {"PostingDate", "Posting Date"}, {"DueDate", "Due Date"}, {"Amount", "Net Amount"}, {"AmountGross", "Gross Amount"}, {"AmountRemaining", "Remaining Amount"}, {"currency_code", "Currency"}, {"order_no", "Order No"}, {"external_document_no", "External Document No"}, {"your_reference", "Your Reference"}, {"cancelled", "Cancelled"}}),
				    Cleaned = Table.TransformColumns(Renamed, {{"Currency", each if _ = null or _ = "" then "LCY" else _, type text}, {"Cancelled", each _ = 1, type logical}}),
				    Overdue = Table.AddColumn(Cleaned, "Is Overdue", each [Remaining Amount] <> 0 and [Due Date] <> null and [Due Date] < Today, type logical),
				    Typed = Table.TransformColumnTypes(Overdue, {{"Posting Date", type datetime}, {"Due Date", type datetime}, {"Net Amount", Currency.Type}, {"Gross Amount", Currency.Type}, {"Remaining Amount", Currency.Type}})
				in
				    Typed

	annotation PBI_ResultType = Exception

