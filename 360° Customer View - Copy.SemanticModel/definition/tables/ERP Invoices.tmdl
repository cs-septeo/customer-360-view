		formatString: dd.MM.yyyy
		lineageTag: 97f5300d-f4f1-49a6-a321-5eb82c823438
		summarizeBy: none
		sourceColumn: Posting Date

		annotation SummarizationSetBy = Automatic

	column 'Due Date'
