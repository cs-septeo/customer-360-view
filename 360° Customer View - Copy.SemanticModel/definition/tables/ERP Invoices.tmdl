		dataType: string
		lineageTag: ce62a1fb-b783-4c9b-96f5-a29b18f43d70
		summarizeBy: none
		sourceColumn: External Document No

		annotation SummarizationSetBy = Automatic

	column 'Your Reference'
		dataType: string
		lineageTag: eed1f348-2d6e-4672-ac1f-7a5114bf3c16
		summarizeBy: none
		sourceColumn: Your Reference

